CREATE TABLE contact (
    fingerprint        TEXT NOT NULL PRIMARY KEY,
    ed25519_public     BLOB NOT NULL,
    key_server_url     TEXT NOT NULL,
    relay_server_url   TEXT NOT NULL,
    contact_mailbox    TEXT NOT NULL,
    stored_at          TEXT NOT NULL,
    -- Display name learned from the contact's encrypted reply_info field.
    -- Empty string until the first message in either direction lands and
    -- carries reply_info; QR scans alone don't set this (the QR doesn't
    -- include display name to keep the QR wire format unchanged).
    display_name       TEXT NOT NULL DEFAULT '',
    -- Acceptance gate (see ROADMAP "Contact acceptance gate"):
    --   'accepted' — contact you initiated (scanned QR / pasted link), or
    --                one whose first message you've already approved. Shown
    --                in the main contact list.
    --   'pending'  — someone you don't yet know who sent you an X3DH
    --                initial. Their messages are received and stored, but
    --                they don't appear in the main list and the push
    --                service suppresses their banners. The user explicitly
    --                Accept-s or Decline-s them from a "Requests" screen.
    -- Existing rows on pre-schema-4 databases default to 'accepted' via
    -- the 3.sqm migration.
    status             TEXT NOT NULL DEFAULT 'accepted',
    -- Deferred protocol payload (JSON-encoded InnerPayload) that
    -- arrived from this contact while they were still pending. Only
    -- ever set for status='pending' rows; cleared on accept (we
    -- process the payload, then null this out). Currently used for
    -- group_invite — without this, a stranger's invite would be
    -- silently dropped because their contact row is pending and the
    -- group_invite branch otherwise short-circuits before the group
    -- gets created locally. Nullable, default null. Added by 4.sqm.
    pending_payload    TEXT,
    -- Local-only fingerprint-verification flag — 0 = unverified, 1 =
    -- user has visually compared this contact's identity-key
    -- fingerprint and accepted that they are who they claim.
    -- Cleared automatically by Messaging.applyX3dhInitialReset on
    -- any key change so a key rotation / recovery / impersonation
    -- attempt drops the badge until re-verification. Never
    -- transmitted to the contact. Added by 6.sqm.
    verified           INTEGER NOT NULL DEFAULT 0,
    -- User-set nickname that overrides the contact's self-reported
    -- display_name in the UI. Local-only, never transmitted.
    -- Nullable; null = fall back to display_name. Added by 7.sqm.
    local_display_name TEXT,
    -- Blocking + muting (#27). Local-only, never transmitted.
    -- blocked: drop on receive, hide from list, refuse sends.
    -- muted: store + show but suppress notifications. Added by 8.sqm.
    blocked            INTEGER NOT NULL DEFAULT 0,
    muted              INTEGER NOT NULL DEFAULT 0,
    -- Whether this contact accepts image attachments, learned from their
    -- `capability_notice` payloads (feat/capability-notice). LOCAL to us —
    -- the contact's stated preference, a UI hint not a hard filter:
    -- 1 = accepts images (default until told otherwise), 0 = prefers
    -- text-only. Added by 13.sqm.
    images_accepted    INTEGER NOT NULL DEFAULT 1
);

-- INSERT OR REPLACE replaces every column including pending_payload.
-- To preserve a previously-stored payload across re-upserts, the
-- DbPersistence saveContact wraps this in a transaction that first
-- reads the current pending_payload and passes it back in. The
-- dedicated [setContactPendingPayload] is the only direct writer.
upsertContact:
INSERT OR REPLACE INTO contact(
    fingerprint, ed25519_public, key_server_url, relay_server_url,
    contact_mailbox, stored_at, display_name, status,
    pending_payload, verified, local_display_name, blocked, muted,
    images_accepted
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setContactPendingPayload:
UPDATE contact SET pending_payload = ? WHERE fingerprint = ?;

setContactImagesAccepted:
UPDATE contact SET images_accepted = ? WHERE fingerprint = ?;

setContactVerified:
UPDATE contact SET verified = ? WHERE fingerprint = ?;

setContactLocalName:
UPDATE contact SET local_display_name = ? WHERE fingerprint = ?;

setContactBlocked:
UPDATE contact SET blocked = ? WHERE fingerprint = ?;

setContactMuted:
UPDATE contact SET muted = ? WHERE fingerprint = ?;

selectBlockedContacts:
SELECT * FROM contact WHERE blocked = 1;

selectContactByFingerprint:
SELECT * FROM contact WHERE fingerprint = ?;

selectAllContacts:
SELECT * FROM contact;

selectPendingContacts:
SELECT * FROM contact WHERE status = 'pending';

updateContactDisplayName:
UPDATE contact SET display_name = ? WHERE fingerprint = ?;

setContactStatus:
UPDATE contact SET status = ? WHERE fingerprint = ?;

deleteContact:
DELETE FROM contact WHERE fingerprint = ?;
