CREATE TABLE message (
    id                  INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    contact_fingerprint TEXT    NOT NULL REFERENCES contact(fingerprint) ON DELETE CASCADE,
    direction           TEXT    NOT NULL CHECK (direction IN ('sent', 'received')),
    body                TEXT    NOT NULL,
    timestamp           TEXT    NOT NULL,
    stored_at           TEXT    NOT NULL,
    -- Sender-issued UUID (java.util.UUID.randomUUID().toString()).
    -- Stamped on every outgoing message and carried through the
    -- inner payload to the recipient; both sides persist the same
    -- value so a later "message_edit" payload can target this
    -- message by reference. Nullable for backward compat with
    -- pre-alpha.14 rows that have no UUID (they remain un-editable).
    message_uuid        TEXT,
    -- 0 = original, 1 = updated via a received message_edit. The
    -- UI surfaces a "(edited)" badge under bubbles where this is 1.
    -- INTEGER rather than BOOLEAN because SQLite (and SQLDelight)
    -- doesn't distinguish; 0/1 is the canonical representation.
    edited              INTEGER NOT NULL DEFAULT 0,
    -- message_uuid of the message this one replies to (quote-reply,
    -- #61). Nullable; null = not a reply. Quoted text is resolved
    -- locally by UUID at render time, never carried on the wire.
    reply_to_uuid       TEXT,
    -- ── Image attachments (ADR 029). All nullable; null on a plain
    -- text message. The full image is NEVER stored in this (encrypted)
    -- DB — only its decryption material, a tiny encrypted thumbnail for
    -- instant inline preview, and a filesystem path to the decrypted
    -- full image once it has been downloaded/cached. media_key/_nonce
    -- are the one-time XChaCha20-Poly1305 key/nonce; thumbnail is the
    -- encrypted thumbnail bytes (decrypted at render time).
    media_id            TEXT,
    media_key           BLOB,
    media_nonce         BLOB,
    media_relay         TEXT,
    thumbnail           BLOB,
    media_cached_path   TEXT,
    -- Outbound delivery state (ADR 030). Nullable: NULL on received
    -- messages (delivery status is a sender-only concept) and on
    -- pre-ADR-030 rows. For sent messages: 'pending' (queued / in
    -- flight, an outbox row exists), 'sent' (relay accepted it), or
    -- 'failed' (gave up after the retry cap). Drives the per-bubble
    -- status indicator.
    delivery_status     TEXT
);

CREATE INDEX message_by_contact ON message(contact_fingerprint, id);
CREATE INDEX message_by_uuid ON message(message_uuid);

insertMessage:
INSERT INTO message(
    contact_fingerprint, direction, body, timestamp, stored_at,
    message_uuid, reply_to_uuid,
    media_id, media_key, media_nonce, media_relay, thumbnail, media_cached_path,
    delivery_status
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMessagesByContact:
SELECT id, direction, body, timestamp, stored_at, message_uuid, edited, reply_to_uuid,
       media_id, media_key, media_nonce, media_relay, thumbnail, media_cached_path,
       delivery_status
  FROM message
 WHERE contact_fingerprint = ?
 ORDER BY id ASC;

-- Update outbound delivery state by sender-issued UUID (ADR 030).
updateMessageDeliveryStatus:
UPDATE message SET delivery_status = ? WHERE message_uuid = ?;

-- Set the local cache path after a full image has been downloaded +
-- decrypted to private storage (ADR 029). Targets by row id.
updateMessageMediaCachedPath:
UPDATE message SET media_cached_path = ? WHERE id = ?;

selectMessageByUuid:
SELECT id, contact_fingerprint, direction, body, timestamp, message_uuid, edited, reply_to_uuid
  FROM message
 WHERE message_uuid = ?
 LIMIT 1;

updateMessageBodyByUuid:
UPDATE message
   SET body = ?, edited = 1
 WHERE message_uuid = ?;

deleteMessageByUuid:
DELETE FROM message WHERE message_uuid = ?;

deleteMessagesForContact:
DELETE FROM message WHERE contact_fingerprint = ?;

deleteAllMessages:
DELETE FROM message;
