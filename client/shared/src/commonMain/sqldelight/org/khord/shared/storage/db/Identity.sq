CREATE TABLE identity (
    id                     INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    ed25519_public         BLOB    NOT NULL,
    ed25519_secret         BLOB    NOT NULL,
    x25519_public          BLOB    NOT NULL,
    x25519_secret          BLOB    NOT NULL,
    fingerprint            TEXT    NOT NULL UNIQUE,
    key_server_url         TEXT    NOT NULL,
    relay_server_url       TEXT    NOT NULL,
    created_at             TEXT    NOT NULL,
    -- 0 until the bundle has been successfully uploaded to the Key Server.
    -- Set to 1 by Messaging.register on a successful uploadBundle. Loaded
    -- back via Messaging.load so partial-registration crashes can recover.
    registered_at_server   INTEGER NOT NULL DEFAULT 0
);

selectIdentity:
SELECT * FROM identity WHERE id = 1;

upsertIdentity:
INSERT OR REPLACE INTO identity(
    id, ed25519_public, ed25519_secret, x25519_public, x25519_secret,
    fingerprint, key_server_url, relay_server_url, created_at,
    registered_at_server
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markRegisteredAtServer:
UPDATE identity SET registered_at_server = 1 WHERE id = 1;

deleteIdentity:
DELETE FROM identity;
