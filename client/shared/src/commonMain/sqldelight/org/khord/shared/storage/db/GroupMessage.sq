-- Per-group message history (ADR 023). Distinct from the per-contact
-- `message` table — group conversations live in their own log keyed by
-- group_id, so members who later join don't accidentally inherit
-- pre-join history. Cross-introduction (showing pre-join history to
-- new members) is explicitly out of scope.
CREATE TABLE group_message (
    id                    INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    group_id              TEXT    NOT NULL REFERENCES "group"(group_id) ON DELETE CASCADE,
    sender_fingerprint    TEXT    NOT NULL,
    sender_display_name   TEXT    NOT NULL DEFAULT '',
    body                  TEXT    NOT NULL,
    timestamp             TEXT    NOT NULL,
    direction             TEXT    NOT NULL CHECK (direction IN ('sent', 'received')),
    stored_at             TEXT    NOT NULL,
    -- See Message.sq for semantics of these two columns; carried in
    -- the inner payload, used by message_edit to target a specific
    -- historical message by sender-issued UUID rather than fragile
    -- (group_id, timestamp) coordinates.
    message_uuid          TEXT,
    edited                INTEGER NOT NULL DEFAULT 0,
    -- message_uuid of the group message this one replies to (#61).
    -- Nullable; null = not a reply. See Message.sq.
    reply_to_uuid         TEXT,
    -- ── Image attachments (ADR 029). See Message.sq for column
    -- semantics. The blob is uploaded ONCE; each member receives the
    -- same media_id + key via their own pairwise channel and fetches
    -- independently, so every member's row carries identical media_*.
    media_id              TEXT,
    media_key             BLOB,
    media_nonce           BLOB,
    media_relay           TEXT,
    thumbnail             BLOB,
    media_cached_path     TEXT
);

CREATE INDEX group_message_by_group ON group_message(group_id, id);
CREATE INDEX group_message_by_uuid ON group_message(message_uuid);

insertGroupMessage:
INSERT INTO group_message(
    group_id, sender_fingerprint, sender_display_name,
    body, timestamp, direction, stored_at, message_uuid, reply_to_uuid,
    media_id, media_key, media_nonce, media_relay, thumbnail, media_cached_path
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectGroupMessages:
SELECT id, sender_fingerprint, sender_display_name, body, timestamp, direction, stored_at, message_uuid, edited, reply_to_uuid,
       media_id, media_key, media_nonce, media_relay, thumbnail, media_cached_path
  FROM group_message
 WHERE group_id = ?
 ORDER BY id ASC;

-- See Message.sq.updateMessageMediaCachedPath.
updateGroupMessageMediaCachedPath:
UPDATE group_message SET media_cached_path = ? WHERE id = ?;

selectGroupMessageByUuid:
SELECT id, group_id, sender_fingerprint, body, timestamp, message_uuid, edited
  FROM group_message
 WHERE message_uuid = ?
 LIMIT 1;

updateGroupMessageBodyByUuid:
UPDATE group_message
   SET body = ?, edited = 1
 WHERE message_uuid = ?;

deleteGroupMessages:
DELETE FROM group_message WHERE group_id = ?;
