-- Client-side groups (ADR 023). The Relay Server has no concept of
-- groups; every group operation fans out via per-member pairwise
-- Double Ratchet channels.
--
-- Quoted because GROUP is a SQL reserved word.
CREATE TABLE "group" (
    group_id                TEXT NOT NULL PRIMARY KEY,
    group_name              TEXT NOT NULL,
    created_by_fingerprint  TEXT NOT NULL,
    -- 1 when the local user is the admin (i.e. the creator). PoC has
    -- exactly one admin per group (the creator). Multi-admin is out of
    -- scope per ADR 023.
    is_admin                INTEGER NOT NULL DEFAULT 0,
    created_at              TEXT NOT NULL
);

upsertGroup:
INSERT OR REPLACE INTO "group"(
    group_id, group_name, created_by_fingerprint, is_admin, created_at
) VALUES (?, ?, ?, ?, ?);

selectGroup:
SELECT * FROM "group" WHERE group_id = ?;

selectAllGroups:
SELECT * FROM "group" ORDER BY created_at ASC;

updateGroupName:
UPDATE "group" SET group_name = ? WHERE group_id = ?;

deleteGroup:
DELETE FROM "group" WHERE group_id = ?;
