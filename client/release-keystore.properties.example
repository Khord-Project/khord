# Release-signing config for the Android `:android:assembleProdRelease`
# build (committed only as `.example`; the real file lives next to it as
# `release-keystore.properties`, gitignored).
#
# storeFile is resolved from the `:android` project directory
# (client/android/), so `../khord-release.jks` points at client/khord-release.jks.
# In CI the keystore is decoded from the KEYSTORE_BASE64 secret to that
# exact path; locally you `cp` your own keystore there.
#
# For PKCS12 keystores (the default in modern keytool — `.jks` extension
# does not override the format), storePassword and keyPassword MUST be
# identical. JKS-format keystores allow them to differ, but we don't use
# those.
storeFile=../khord-release.jks
storePassword=YOUR_PASSWORD
keyAlias=khord
keyPassword=YOUR_PASSWORD
