<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
         Foreground service for the WebSocket push listener (ADR 022).
         specialUse, not dataSync: Android 14+ enforces a 6-hour cap on
         dataSync services and throws ForegroundServiceDidNotStopInTimeException
         when it fires (see closed-out issues #50 / #52). Khord's push
         WebSocket is meant to run as long as the user wants notifications;
         there is no defined FGS type that fits (it's not connectedDevice,
         not mediaPlayback, not location). specialUse covers exactly this
         shape, and has no timeout by design.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".KhordApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Khord">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Khord">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             FileProvider for sharing decrypted image attachments out to
             other apps via the system share sheet (ADR 029). Grants
             one-shot read URIs into the app-private media cache; no other
             app can browse the cache, only receive a specific shared file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".push.KhordPushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!--
                Android 14+ requires a justification for specialUse FGS.
                The value here is the answer to "why doesn't a defined
                type fit?"; the Play Store / sideload reviewer reads it
                when assessing the manifest.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains an end-to-end encrypted WebSocket to the Relay Server for real-time message delivery. No defined FGS type fits: dataSync has a 6h timeout that breaks the use case; the WebSocket is not connectedDevice / mediaPlayback / location." />
        </service>
    </application>

</manifest>
