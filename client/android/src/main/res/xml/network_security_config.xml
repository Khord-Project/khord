<?xml version="1.0" encoding="utf-8"?>
<!--
  PoC network policy: cleartext HTTP is permitted globally so the app can
  reach a developer's Docker compose stack at whatever address it happens
  to live (10.0.2.2 from the emulator, 192.168.x.x on a LAN, etc.) without
  having to enumerate every reviewer's home IP here.

  TODO(release): TIGHTEN BEFORE ANY PRODUCTION BUILD. Production deploys
  must replace this with HTTPS-everywhere — either remove this file (the
  framework default rejects cleartext on API 28+) or scope cleartext to a
  specific staging-only domain. Shipping a release APK with this config
  would let any on-path attacker downgrade Khord to plaintext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
