# Khord Relay Server — Coolify environment template (ADR 024).
#
# Goes into the Coolify "Environment Variables" UI of the RELAY SERVER
# application — NOT into a file on disk. This file is a checklist and
# documentation source only. The Key Server has its own template:
# .env.coolify.keyserver.example.
#
# Generate the password locally before pasting:
#
#   openssl rand -hex 24   # → RELAYSERVER_DB_PASSWORD
#
# Postgres reads its password ONCE at volume init, so pick it BEFORE
# the first deploy. Rotating later requires either re-creating the
# volume (data loss) or running `ALTER USER khord_rs PASSWORD ...`
# inside the container before updating the env var.

# Postgres password for the relayserver database. Same scope-and-risk
# story as the keyserver — DB is only reachable on the application's
# private Docker network.
RELAYSERVER_DB_PASSWORD=replace-with-strong-password

# ── Tunables (defaults shown) ───────────────────────────────────────────────
# Proof-of-work difficulty for mailbox creation. 16 bits ≈ a couple
# of seconds on a phone, hard enough to dissuade spray-creation
# without blocking legitimate users on first contact-add. Lower to
# 12 if you have aggressive abuse to deter; bumping higher than 18
# starts to be noticeable on low-end Android devices.
RELAY_PROOF_OF_WORK_DIFFICULTY_BITS=16

# How long the relay holds an undelivered message before TTL-expiring
# it. 604800 = 7 days. Messages are also deleted on delivery
# confirmation regardless of TTL; the TTL is the "you went on
# vacation for a week" safety net.
RELAY_MESSAGE_TTL_SECONDS=604800
