# Khord Key Server — Coolify environment template (ADR 024).
#
# Goes into the Coolify "Environment Variables" UI of the KEY SERVER
# application — NOT into a file on disk. This file is a checklist and
# documentation source only. The Relay Server has its own template:
# .env.coolify.relayserver.example.
#
# Generate strong random values locally before pasting:
#
#   openssl rand -hex 32   # → KEY_SERVER_TOKEN_SECRET
#   openssl rand -hex 24   # → KEYSERVER_DB_PASSWORD
#
# Postgres reads its password ONCE at volume init, so pick the
# password BEFORE the first deploy. Rotating later requires either
# re-creating the volume (data loss) or running
# `ALTER USER khord_ks PASSWORD ...` inside the container before
# updating the env var.

# HMAC-SHA256 secret used by the key server to sign short-lived
# session tokens. Rotating this invalidates every in-flight token;
# clients transparently re-authenticate on the next 401.
KEY_SERVER_TOKEN_SECRET=replace-with-32-bytes-of-randomness

# Postgres password for the keyserver database. The database is only
# reachable on the application's private Docker network — no host
# port binding — but credentials still matter (a compromised server
# app should not double as a DB-superuser bypass).
KEYSERVER_DB_PASSWORD=replace-with-strong-password
