# Khord deployment environment for Coolify (https://coolify.io).
#
# These variables go into Coolify's "Environment Variables" UI for the
# Docker Compose resource — NOT into a .env file on disk (Coolify
# injects them at runtime). This file is kept as a checklist /
# documentation source, not as something you copy to a host.
#
# All five variables below are required. Defaults shown for the two
# tunables match the standalone production stack.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Strong random values. Generate locally before pasting into Coolify:
#
#   openssl rand -hex 32   # → KEY_SERVER_TOKEN_SECRET
#   openssl rand -hex 24   # → KEYSERVER_DB_PASSWORD, RELAYSERVER_DB_PASSWORD
#
# Postgres reads its password ONCE at volume init, so pick these BEFORE
# the first deploy. Rotating later requires either re-creating the
# volume (data loss) or running `ALTER USER ... PASSWORD ...` inside the
# container before updating the env var.

# HMAC-SHA256 secret used by the key server to sign short-lived session
# tokens. Rotating this invalidates every in-flight token; clients
# transparently re-authenticate on the next 401.
KEY_SERVER_TOKEN_SECRET=replace-with-32-bytes-of-randomness

# Postgres passwords. Each database is in its own Docker network and is
# never exposed on a host port, but credentials still matter — a
# compromised server-app should not double as a DB-superuser bypass.
KEYSERVER_DB_PASSWORD=replace-with-strong-password
RELAYSERVER_DB_PASSWORD=replace-with-strong-password

# ── Tunables ─────────────────────────────────────────────────────────────────

# Bits of Hashcash-style proof-of-work the relay server requires before
# accepting a new mailbox creation (ADR 012). 16 ≈ ~65k SHA-256 ops:
# tens of milliseconds on a modern phone, several minutes for thousands
# of spam attempts. Raise for hostile environments; lower wastes battery.
RELAY_PROOF_OF_WORK_DIFFICULTY_BITS=16

# Server-side TTL for queued messages, in seconds. After this many
# seconds, mail still sitting in a relay mailbox is opportunistically
# purged (ADR 007). 604800 = 7 days.
RELAY_MESSAGE_TTL_SECONDS=604800
